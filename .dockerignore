.env.production

# Node.js (if any)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Flutter (build outputs)
flutter_app/build/
flutter_app/.dart_tool/
flutter_app/.packages

# Monitoring configs (mount as volumes)
monitoring/
prometheus.yml
grafana/

# Scripts (development only)
scripts/
*.sh
*.bat